// Modelo entidad-relacion del sistema SIRA (notacion pata de gallo)
// Generar: dot -Tpdf modelo-entidad-relacion.dot -o modelo-entidad-relacion.pdf
digraph MER {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, pad=0.3,
         fontname="Arial", fontsize=16, labelloc=t,
         label="SIRA — Modelo entidad-relación (PostgreSQL 16)"];
  node  [shape=plaintext, fontname="Arial", fontsize=10];
  edge  [dir=both, color="#555555", arrowsize=0.9, penwidth=1.0];

  roles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A7A7A"><TR><TD COLSPAN="3" BGCOLOR="#E5E7EB"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol_w"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT"><B>id_rol</B></TD><TD ALIGN="LEFT" PORT="id_rol_e"><FONT POINT-SIZE="8" COLOR="#555555">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_w"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT" PORT="nombre_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion_w"> </TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT" PORT="descripcion_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(150)</FONT></TD></TR></TABLE>>];
  usuarios [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A7A7A"><TR><TD COLSPAN="3" BGCOLOR="#E5E7EB"><B>usuarios</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT" PORT="id_usuario_e"><FONT POINT-SIZE="8" COLOR="#555555">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username_w"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT" PORT="username_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash_w"> </TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT" PORT="password_hash_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email_w"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol_w"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT"><I>id_rol</I></TD><TD ALIGN="LEFT" PORT="id_rol_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo_w"> </TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT" PORT="activo_e"><FONT POINT-SIZE="8" COLOR="#555555">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"> </TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR></TABLE>>];
  pacientes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A7A7A"><TR><TD COLSPAN="3" BGCOLOR="#DBEAFE"><B>pacientes</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_paciente_w"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT"><B>id_paciente</B></TD><TD ALIGN="LEFT" PORT="id_paciente_e"><FONT POINT-SIZE="8" COLOR="#555555">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_documento_w"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">tipo_documento</TD><TD ALIGN="LEFT" PORT="tipo_documento_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero_documento_w"><FONT POINT-SIZE="8">UQ</FONT></TD><TD ALIGN="LEFT">numero_documento</TD><TD ALIGN="LEFT" PORT="numero_documento_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombres_w"> </TD><TD ALIGN="LEFT">nombres</TD><TD ALIGN="LEFT" PORT="nombres_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="apellido_paterno_w"> </TD><TD ALIGN="LEFT">apellido_paterno</TD><TD ALIGN="LEFT" PORT="apellido_paterno_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="apellido_materno_w"> </TD><TD ALIGN="LEFT">apellido_materno</TD><TD ALIGN="LEFT" PORT="apellido_materno_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_nacimiento_w"> </TD><TD ALIGN="LEFT">fecha_nacimiento</TD><TD ALIGN="LEFT" PORT="fecha_nacimiento_e"><FONT POINT-SIZE="8" COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sexo_w"> </TD><TD ALIGN="LEFT">sexo</TD><TD ALIGN="LEFT" PORT="sexo_e"><FONT POINT-SIZE="8" COLOR="#555555">CHAR(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono_w"> </TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT" PORT="telefono_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email_w"> </TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion_w"> </TD><TD ALIGN="LEFT">direccion</TD><TD ALIGN="LEFT" PORT="direccion_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_convenio_w"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT"><I>id_convenio</I></TD><TD ALIGN="LEFT" PORT="id_convenio_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="antecedentes_medicos_w"> </TD><TD ALIGN="LEFT">antecedentes_medicos</TD><TD ALIGN="LEFT" PORT="antecedentes_medicos_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alergias_w"> </TD><TD ALIGN="LEFT">alergias</TD><TD ALIGN="LEFT" PORT="alergias_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo_w"> </TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT" PORT="activo_e"><FONT POINT-SIZE="8" COLOR="#555555">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"> </TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR></TABLE>>];
  atenciones [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A7A7A"><TR><TD COLSPAN="3" BGCOLOR="#DBEAFE"><B>atenciones</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_atencion_w"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT"><B>id_atencion</B></TD><TD ALIGN="LEFT" PORT="id_atencion_e"><FONT POINT-SIZE="8" COLOR="#555555">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_paciente_w"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT"><I>id_paciente</I></TD><TD ALIGN="LEFT" PORT="id_paciente_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_medico_w"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT"><I>id_medico</I></TD><TD ALIGN="LEFT" PORT="id_medico_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_cita_w"><FONT POINT-SIZE="8">FK,UQ</FONT></TD><TD ALIGN="LEFT"><I>id_cita</I></TD><TD ALIGN="LEFT" PORT="id_cita_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_atencion_w"> </TD><TD ALIGN="LEFT">tipo_atencion</TD><TD ALIGN="LEFT" PORT="tipo_atencion_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_w"> </TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_consulta_w"> </TD><TD ALIGN="LEFT">motivo_consulta</TD><TD ALIGN="LEFT" PORT="motivo_consulta_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="anamnesis_w"> </TD><TD ALIGN="LEFT">anamnesis</TD><TD ALIGN="LEFT" PORT="anamnesis_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="indicaciones_w"> </TD><TD ALIGN="LEFT">indicaciones</TD><TD ALIGN="LEFT" PORT="indicaciones_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="inicio_consulta_w"> </TD><TD ALIGN="LEFT">inicio_consulta</TD><TD ALIGN="LEFT" PORT="inicio_consulta_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="finalizada_en_w"> </TD><TD ALIGN="LEFT">finalizada_en</TD><TD ALIGN="LEFT" PORT="finalizada_en_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="anulado_w"> </TD><TD ALIGN="LEFT">anulado</TD><TD ALIGN="LEFT" PORT="anulado_e"><FONT POINT-SIZE="8" COLOR="#555555">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_anulacion_w"> </TD><TD ALIGN="LEFT">motivo_anulacion</TD><TD ALIGN="LEFT" PORT="motivo_anulacion_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="anulado_por_w"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT"><I>anulado_por</I></TD><TD ALIGN="LEFT" PORT="anulado_por_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="anulado_en_w"> </TD><TD ALIGN="LEFT">anulado_en</TD><TD ALIGN="LEFT" PORT="anulado_en_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"> </TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR></TABLE>>];
  triajes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A7A7A"><TR><TD COLSPAN="3" BGCOLOR="#DBEAFE"><B>triajes</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_triaje_w"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT"><B>id_triaje</B></TD><TD ALIGN="LEFT" PORT="id_triaje_e"><FONT POINT-SIZE="8" COLOR="#555555">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_atencion_w"><FONT POINT-SIZE="8">FK,UQ</FONT></TD><TD ALIGN="LEFT"><I>id_atencion</I></TD><TD ALIGN="LEFT" PORT="id_atencion_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="presion_sistolica_w"> </TD><TD ALIGN="LEFT">presion_sistolica</TD><TD ALIGN="LEFT" PORT="presion_sistolica_e"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="presion_diastolica_w"> </TD><TD ALIGN="LEFT">presion_diastolica</TD><TD ALIGN="LEFT" PORT="presion_diastolica_e"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="temperatura_w"> </TD><TD ALIGN="LEFT">temperatura</TD><TD ALIGN="LEFT" PORT="temperatura_e"><FONT POINT-SIZE="8" COLOR="#555555">NUMERIC(4,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="frecuencia_cardiaca_w"> </TD><TD ALIGN="LEFT">frecuencia_cardiaca</TD><TD ALIGN="LEFT" PORT="frecuencia_cardiaca_e"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="frecuencia_respiratoria_w"> </TD><TD ALIGN="LEFT">frecuencia_respiratoria</TD><TD ALIGN="LEFT" PORT="frecuencia_respiratoria_e"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="saturacion_oxigeno_w"> </TD><TD ALIGN="LEFT">saturacion_oxigeno</TD><TD ALIGN="LEFT" PORT="saturacion_oxigeno_e"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="peso_w"> </TD><TD ALIGN="LEFT">peso</TD><TD ALIGN="LEFT" PORT="peso_e"><FONT POINT-SIZE="8" COLOR="#555555">NUMERIC(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="talla_w"> </TD><TD ALIGN="LEFT">talla</TD><TD ALIGN="LEFT" PORT="talla_e"><FONT POINT-SIZE="8" COLOR="#555555">NUMERIC(3,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observaciones_w"> </TD><TD ALIGN="LEFT">observaciones</TD><TD ALIGN="LEFT" PORT="observaciones_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_enfermera_w"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT"><I>id_enfermera</I></TD><TD ALIGN="LEFT" PORT="id_enfermera_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registrado_en_w"> </TD><TD ALIGN="LEFT">registrado_en</TD><TD ALIGN="LEFT" PORT="registrado_en_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR></TABLE>>];
