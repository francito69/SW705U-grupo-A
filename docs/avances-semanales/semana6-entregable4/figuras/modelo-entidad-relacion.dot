  outbox_notificaciones [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A7A7A"><TR><TD COLSPAN="3" BGCOLOR="#E5E7EB"><B>outbox_notificaciones</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_notificacion_w"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT"><B>id_notificacion</B></TD><TD ALIGN="LEFT" PORT="id_notificacion_e"><FONT POINT-SIZE="8" COLOR="#555555">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_cita_w"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT"><I>id_cita</I></TD><TD ALIGN="LEFT" PORT="id_cita_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_evento_w"> </TD><TD ALIGN="LEFT">tipo_evento</TD><TD ALIGN="LEFT" PORT="tipo_evento_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="canal_w"> </TD><TD ALIGN="LEFT">canal</TD><TD ALIGN="LEFT" PORT="canal_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="destinatario_w"> </TD><TD ALIGN="LEFT">destinatario</TD><TD ALIGN="LEFT" PORT="destinatario_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mensaje_w"> </TD><TD ALIGN="LEFT">mensaje</TD><TD ALIGN="LEFT" PORT="mensaje_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="programado_para_w"> </TD><TD ALIGN="LEFT">programado_para</TD><TD ALIGN="LEFT" PORT="programado_para_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_w"> </TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="intentos_w"> </TD><TD ALIGN="LEFT">intentos</TD><TD ALIGN="LEFT" PORT="intentos_e"><FONT POINT-SIZE="8" COLOR="#555555">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="error_detalle_w"> </TD><TD ALIGN="LEFT">error_detalle</TD><TD ALIGN="LEFT" PORT="error_detalle_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="procesado_en_w"> </TD><TD ALIGN="LEFT">procesado_en</TD><TD ALIGN="LEFT" PORT="procesado_en_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en_w"> </TD><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT" PORT="creado_en_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR></TABLE>>];
  bitacora_auditoria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7A7A7A"><TR><TD COLSPAN="3" BGCOLOR="#E5E7EB"><B>bitacora_auditoria</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_auditoria_w"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT"><B>id_auditoria</B></TD><TD ALIGN="LEFT" PORT="id_auditoria_e"><FONT POINT-SIZE="8" COLOR="#555555">BIGSERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_w"><FONT POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT"><I>id_usuario</I></TD><TD ALIGN="LEFT" PORT="id_usuario_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre_tabla_w"> </TD><TD ALIGN="LEFT">nombre_tabla</TD><TD ALIGN="LEFT" PORT="nombre_tabla_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_registro_afectado_w"> </TD><TD ALIGN="LEFT">id_registro_afectado</TD><TD ALIGN="LEFT" PORT="id_registro_afectado_e"><FONT POINT-SIZE="8" COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="accion_w"> </TD><TD ALIGN="LEFT">accion</TD><TD ALIGN="LEFT" PORT="accion_e"><FONT POINT-SIZE="8" COLOR="#555555">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="direccion_ip_w"> </TD><TD ALIGN="LEFT">direccion_ip</TD><TD ALIGN="LEFT" PORT="direccion_ip_e"><FONT POINT-SIZE="8" COLOR="#555555">INET</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="datos_anteriores_w"> </TD><TD ALIGN="LEFT">datos_anteriores</TD><TD ALIGN="LEFT" PORT="datos_anteriores_e"><FONT POINT-SIZE="8" COLOR="#555555">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="datos_nuevos_w"> </TD><TD ALIGN="LEFT">datos_nuevos</TD><TD ALIGN="LEFT" PORT="datos_nuevos_e"><FONT POINT-SIZE="8" COLOR="#555555">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_w"> </TD><TD ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT" PORT="motivo_e"><FONT POINT-SIZE="8" COLOR="#555555">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_hora_w"> </TD><TD ALIGN="LEFT">fecha_hora</TD><TD ALIGN="LEFT" PORT="fecha_hora_e"><FONT POINT-SIZE="8" COLOR="#555555">TIMESTAMP</FONT></TD></TR></TABLE>>];

